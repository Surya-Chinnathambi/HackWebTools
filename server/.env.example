# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# MongoDB (Free tier: https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hackwebtools?retryWrites=true&w=majority

# JWT Secret (Generate: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Free API Keys

# Google Gemini AI API (FREE tier - https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# NVD API (FREE - https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_optional

# VirusTotal API (FREE tier: 4 req/min - https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# GitHub API (FREE: 5000 req/hour - https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_personal_access_token

# Shodan API (FREE: 100 queries/month - https://account.shodan.io/register)
SHODAN_API_KEY=your_shodan_api_key

# SecurityTrails API (FREE tier - https://securitytrails.com/app/signup)
SECURITYTRAILS_API_KEY=your_securitytrails_api_key

# AbuseIPDB (FREE: 1000 checks/day - https://www.abuseipdb.com/register)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
